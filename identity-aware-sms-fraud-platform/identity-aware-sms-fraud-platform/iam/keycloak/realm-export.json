{
  "realm": "sms-fraud",
  "enabled": true,
  "displayName": "SMS Fraud Platform (lab)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and notUsername",
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "fraud_analyst",
        "description": "First-line monitoring. Masked data only."
      },
      {
        "name": "fraud_investigator",
        "description": "Investigates alerts; justified unmask; requests connection actions."
      },
      {
        "name": "rule_engineer",
        "description": "Proposes detection rule changes; cannot approve them."
      },
      {
        "name": "fraud_manager",
        "description": "Approves rule changes and connection actions."
      },
      {
        "name": "auditor",
        "description": "Read-only oversight incl. audit log."
      },
      {
        "name": "platform_admin",
        "description": "Manages identities/platform; no access to fraud data."
      }
    ]
  },
  "users": [
